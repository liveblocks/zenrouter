{
  "name": "@liveblocks/zenrouter",
  "version": "1.3.0",
  "description": "An opinionated HTTP router with typed path params, built-in body validation, and a clean auth model.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "module": "./dist/index.js",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist/**",
    "README.md"
  ],
  "bugs": {
    "url": "https://github.com/liveblocks/zenrouter/issues"
  },
  "scripts": {
    "dev:docs": "pnpm run --filter docs dev",
    "build": "tsup",
    "format": "eslint --color --fix src/ test/; prettier --write src/ test/",
    "lint": "eslint --color src/ test/",
    "lint:package": "publint --strict && attw --pack",
    "test": "vitest run --color",
    "test:watch": "vitest watch --color",
    "test:types": "vitest run --config vitest.config.typecheck.ts --color",
    "release": "release-it",
    "prepare": "syncpack lint"
  },
  "license": "Apache-2.0",
  "author": "Liveblocks Inc.",
  "packageManager": "pnpm@10.33.1",
  "peerDependencies": {
    "hotscript": "^1.0.13"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@release-it/keep-a-changelog": "^7.1.0",
    "decoders": "^2.12.1",
    "eslint": "^9.39.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "nanoid": "^5.1.16",
    "prettier": "^3.9.9",
    "publint": "^0.3.24",
    "release-it": "^20.2.1",
    "syncpack": "^14.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11",
    "zod": "^4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liveblocks/zenrouter.git"
  },
  "sideEffects": false
}
