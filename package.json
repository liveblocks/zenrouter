{
  "name": "@liveblocks/zenrouter",
  "version": "1.0.18-rc.0",
  "description": "An opinionated HTTP router with typed path params, built-in body validation, and a clean auth model.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "module": "./dist/index.js",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist/**",
    "README.md"
  ],
  "bugs": {
    "url": "https://github.com/liveblocks/zenrouter/issues"
  },
  "scripts": {
    "dev:docs": "pnpm run --filter docs dev",
    "build": "tsup",
    "format": "eslint --color --fix src/ test/; prettier --write src/ test/",
    "lint": "eslint --color src/ test/",
    "lint:package": "publint --strict && attw --pack",
    "test": "vitest run --color",
    "test:watch": "vitest watch --color",
    "test:types": "vitest run --config vitest.config.typecheck.ts --color",
    "release": "release-it",
    "postinstall": "syncpack lint"
  },
  "license": "Apache-2.0",
  "author": "Liveblocks Inc.",
  "packageManager": "pnpm@10.33.0",
  "peerDependencies": {
    "hotscript": "^1.0.13"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@eslint/js": "^9.39.4",
    "@release-it/keep-a-changelog": "^7.0.1",
    "decoders": "^2.9.3",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "fast-check": "^4.7.0",
    "globals": "^17.5.0",
    "nanoid": "^5",
    "prettier": "^3.8.3",
    "publint": "^0.3.18",
    "release-it": "^20.0.0",
    "syncpack": "^14.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.5",
    "zod": "^4.3.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liveblocks/zenrouter.git"
  },
  "sideEffects": false
}
